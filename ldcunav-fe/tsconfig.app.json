{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],

    "useDefineForClassFields": true,
    "allowJs": false,
    "allowArbitraryExtensions": true,

    "types": [
      "vite/client"
    ],

    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}
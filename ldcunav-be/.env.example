# ==============================================================================
# LdcuNav Backend Environment Configuration Example
# Copy this file to .env and adjust credentials to match your local setup:
#   cp .env.example .env
#   php artisan key:generate
# ==============================================================================

APP_NAME=LdcuNav
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# LdcuNav uses PostgreSQL exclusively. Both the Laravel PDO PrismaClient and
# the Prisma CLI rely on these settings.
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ldcunav
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ------------------------------------------------------------------------------
# Prisma Connection String
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Used by the Prisma CLI for migrations (prisma migrate deploy / status).
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:your_postgres_password@127.0.0.1:5432/ldcunav?schema=public"

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Allowed origin for Cross-Origin Resource Sharing (CORS).
# Defaults to the Vue 3 Vite dev server in development.
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Session, Cache & Queue (Local Array / Memory Defaults)
# ------------------------------------------------------------------------------
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

# ------------------------------------------------------------------------------
# Mail (Log Driver for Local Development)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@liceo.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"
